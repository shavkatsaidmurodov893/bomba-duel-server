# Neon (yoki boshqa Postgres) ulanish satri
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Tiklash kodlarini himoyalash uchun maxfiy satr (o'zgartirmang keyin)
RECOVERY_SECRET=uzun-tasodifiy-satr-yozing

# Kuniga bitta hisob uchun reklama mukofoti limiti
AD_DAILY=10

# Lokal ishlash uchun (Postgres o'rniga xotiradagi baza):
# DB_DRIVER=memory
